# Copy to .env next to docker-compose.yml.

# The image tag: a commit build.sh published (latest = the last one published).
VULN_LAB_TAG=latest

# The zoo: the address the scanner reaches this host at. It goes into
# zoo-out/zoo.yaml and zoo-out/targets.txt. Required for the zoo profiles.
ZOO_ADDRESS=
# zoo-smoke only; ZOO_SAFE_PORT must be ZOO_PORT + 50. zoo-all uses 9100-9119
# and 9150-9169.
#ZOO_PORT=9100
#ZOO_SAFE_PORT=9150

# Published ports (defaults: the local lab's, which the bench ground truth names).
#CLAIMDESK_PORT=8101
#GEOSERVER_PORT=8102
#LARDER_PORT=8201
#METABASE_PORT=8202
#EDGE_PORT=8300
#SHOPFRONT_PORT=8301
#TASKHUB_PORT=8302
#GATEWAY_PORT=8303
#REDIS_PORT=8306
#ECHO_PORT=8307
